{
  "family": "qwen-inference",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "4096",
  "memory": "8192",
  "executionRoleArn": "arn:aws:iam::713881810585:role/source_trace_analysis_mngr_exec_role",
  "taskRoleArn": "arn:aws:iam::713881810585:role/source_trace_analysis_mngr_task_role",
  "containerDefinitions": [
    {
      "name": "qwen-inference",
      "image": "ghcr.io/ggml-org/llama.cpp:server",
      "essential": true,
      "command": [
        "-m", "/mnt/model/Qwen3-8B-UD-Q4_K_XL.gguf",
        "--host", "0.0.0.0",
        "--port", "3001",
        "-c", "4096"
      ],
      "portMappings": [
        { "containerPort": 3001, "protocol": "tcp" }
      ],
      "mountPoints": [
        {
          "sourceVolume": "model-efs",
          "containerPath": "/mnt/model",
          "readOnly": true
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/qwen-inference",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "qwen-inference",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "model-efs",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-07625cbf2e8c80d10",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "fsap-059833b48f611da70",
          "iam": "ENABLED"
        }
      }
    }
  ]
}
