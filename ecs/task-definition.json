{
  "family": "source_trace_analysis_mngr",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::713881810585:role/source_trace_analysis_mngr_exec_role",
  "taskRoleArn": "arn:aws:iam::713881810585:role/source_trace_analysis_mngr_task_role",
  "containerDefinitions": [
    {
      "name": "analysis-mngr",
      "image": "IMAGE_PLACEHOLDER",
      "essential": true,
      "environment": [
        { "name": "WORKDIR", "value": "/mnt/repo" },
        { "name": "MODEL_SERVICE_URL", "value": "http://qwen-inference.source-trace.local:3001" },
        { "name": "DEBUG", "value": "app:*" },
        { "name": "DYNAMODB_TABLE_NAME", "value": "source_trace_db" }
      ],
      "mountPoints": [
        {
          "sourceVolume": "repo-efs",
          "containerPath": "/mnt/repo",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/analysis-mngr",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "analysis-mngr",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "repo-efs",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-0264af2239d549bec",
        "transitEncryption": "ENABLED",
        "authorizationConfig": {
          "accessPointId": "fsap-049704f16a0c6a217",
          "iam": "ENABLED"
        }
      }
    }
  ]
}
